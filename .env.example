DATABASE_URL=postgresql+asyncpg://acervo:acervo@localhost:55433/acervo
S3_ENDPOINT=http://localhost:59000
S3_ACCESS_KEY=acervo
S3_SECRET_KEY=acervo-secret
S3_BUCKET=acervo
CORS_ORIGINS=["http://localhost:5173"]
# Any long random string, e.g. `python -c "import secrets; print(secrets.token_urlsafe(32))"`.
SESSION_SECRET=change-me-too
PUBLIC_URL=http://localhost:5173
# Mailpit from docker compose; leave SMTP_HOST empty to send nothing.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=false
MAIL_FROM=Acervo <acervo@localhost>
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Passkeys: empty takes the domain and origin of PUBLIC_URL.
WEBAUTHN_RP_ID=
WEBAUTHN_ORIGIN=
# Meta WhatsApp Cloud API; leave WHATSAPP_TOKEN empty to send no WhatsApp codes.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=acervo_codigo
WHATSAPP_LANGUAGE=pt_BR
# Emails of the Acervo team who edit the emails' texts, comma separated.
ADMIN_EMAILS=
# Temporal, which runs the daily digest.
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=acervo
